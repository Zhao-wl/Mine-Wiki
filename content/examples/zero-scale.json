{
  "id": "zero-scale",
  "title": "一个可逐步压扁的二维变换",
  "conventions": "本例使用列向量；x 向右、y 向上；矩阵乘积右侧先执行。先在二维建立直觉，再推广到三维。",
  "formula": "F_s(x,y) = (3−y, 2+s·x)\nA_s = [[0,−1],[s,0]]\n先 x 缩放 s → 逆时针 90° → 平移 (3,2)\ns=2 时，(1,1) → (2,4)",
  "facts": {
    "s": 2,
    "point": [
      1,
      1
    ],
    "translation": [
      3,
      2
    ],
    "world": [
      2,
      4
    ],
    "oldScale": 0,
    "newScale": 2
  }
}
